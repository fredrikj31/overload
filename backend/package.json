{
  "name": "@overload/backend",
  "version": "1.0.0",
  "main": "src/app.ts",
  "scripts": {
    "dev": "tsx watch --include src src/app.ts | pino-pretty",
    "build": "tsc -p tsconfig.build.json",
    "build:check": "tsc --noEmit",
    "auth:generate": "pnpm dlx auth@latest generate --config src/auth/cli.ts --output src/database/schemas/auth.ts",
    "database:generate": "pnpm exec drizzle-kit generate",
    "database:migrate": "pnpm exec drizzle-kit migrate"
  },
  "dependencies": {
    "better-auth": "^1.7.6",
    "dotenv": "^18.0.4",
    "drizzle-orm": "^1.0.0-rc.4",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "1.0.0-rc.4",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
