{
  "name": "overload",
  "description": "An open source workout tracker application.",
  "author": "fredrikj31",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "pre-commit": "lint-staged -c lint-staged.config.js",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "backend:dev": "pnpm database:build && pnpm --filter @overload/backend dev",
    "backend:build": "pnpm --filter @overload/backend... build",
    "backend:build:check": "pnpm database:build && pnpm --filter @overload/backend build:check",
    "backend:auth:generate": "pnpm --filter @overload/backend auth:generate",
    "frontend:dev": "pnpm --filter @overload/frontend dev",
    "frontend:build": "pnpm --filter @overload/frontend build",
    "frontend:build:check": "pnpm --filter @overload/frontend build:check",
    "database:build": "pnpm --filter @overload/database build",
    "database:build:check": "pnpm --filter @overload/database build:check",
    "database:generate": "pnpm --filter @overload/database database:generate",
    "database:migrate": "pnpm --filter @overload/database database:migrate",
    "seeder:build": "pnpm --filter @overload/seeder... build",
    "seeder:build:check": "pnpm database:build && pnpm --filter @overload/seeder build:check",
    "seeder:run": "pnpm database:build && pnpm --filter @overload/seeder dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fredrikj31/overload.git"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.0.0",
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.8",
    "semantic-release": "^25.0.9",
    "semantic-release-export-data": "^1.2.0"
  }
}
