# DEVELOPMENT
API_HOST=0.0.0.0
API_PORT=3000
AUTH_BASE_URL=http://127.0.0.1:3000/api/auth
AUTH_SECRET= # Random generated string with high entropy (must be at least 32 characters)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER= # Random generated string
DATABASE_PASSWORD= # Random generated string
DATABASE_NAME=overload
WEBSITE_BASE_URL=http://127.0.0.1:5173
VITE_API_BASE_URL=http://127.0.0.1:3000/api
VITE_MEDIA_BASE_URL=http://127.0.0.1:5003/media # Where the frontend loads exercise images/gifs from (dev-media nginx)
MEDIA_DIR=../.docker/media # Where the seeder writes exercise media (relative to the seeder package), served by dev-media
# VITE_APP_VERSION=dev # Optional, shown on the About page. Set automatically by the release workflow in production

# PRODUCTION
COMPOSE_PROFILES=prod
BACKEND_PORT=5001
FRONTEND_PORT=5002
MEDIA_PORT=5003
AUTH_BASE_URL=https://<REPLACE WITH HOST>/api/auth
AUTH_SECRET= # Random generated string with high entropy (must be at least 32 characters)
DATABASE_PORT=5000
DATABASE_USER= # Random generated string
DATABASE_PASSWORD= # Random generated string
MY_APP_API_BASE_URL=https://<REPLACE WITH HOST>/api
MY_APP_MEDIA_BASE_URL=https://<REPLACE WITH HOST>/media
WEBSITE_BASE_URL=https://<REPLACE WITH HOST>
